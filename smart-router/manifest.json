{
  "$schema": "https://akshay-software-hub/schemas/manifest.v1.json",
  "id": "smart-router",
  "name": "Promptaro Smart Router",
  "description": "One instruction in, the right model out: picks the cheapest model that meets the quality bar, checks the result and escalates when needed. Also where AI accounts are connected. Start with 'Start Smart Router.command' or uvicorn router.api:app.",
  "icon": "zap",
  "color": "#2F8F83",
  "category": "AI Agents",
  "version": "0.2.0",
  "owner": "Akshay Dubey",
  "license": "PolyForm-Small-Business-1.0.0",
  "environment": "development",
  "launchType": "new_tab",
  "url": "http://localhost:8765/",
  "apiEndpoint": null,
  "healthCheckUrl": "http://localhost:8765/healthz",
  "allowedOrigins": [
    "http://localhost:8765"
  ],
  "authMethod": "none",
  "credentialRef": null,
  "permissions": [],
  "aiRequired": false,
  "aiOptional": true,
  "supportedProviders": [
    "openrouter",
    "claude",
    "openai",
    "gemini",
    "ollama"
  ],
  "capabilities": [
    {
      "key": "router.run",
      "aiMode": "required",
      "label": "Route an instruction to the best model"
    }
  ],
  "timeouts": {
    "connectMs": 3000,
    "readMs": 120000
  },
  "healthCheck": {
    "intervalSeconds": 60,
    "failureThreshold": 3,
    "timeoutMs": 3000
  }
}
