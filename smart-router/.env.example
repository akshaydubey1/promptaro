# Copy to .env for `docker compose` (it reads env_file: .env) or export for local runs.
# Every name here may also live in the OS keychain instead; env vars take precedence.

# Paid providers (billed per use — only used when spend is allowed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Free providers (free tiers with per-minute/day limits; the router tracks each one)
# GEMINI_API_KEY (above) also unlocks the AI Studio free tier — flash models route through it at $0.
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN=                # personal access token → GitHub Models free inference

# Plan providers (your own subscription, no metered billing)
# GitHub Copilot: sign in from the app's Connections page ("Sign in with GitHub") — no env var needed.
# GITHUB_COPILOT_TOKEN=        # or paste a GitHub OAuth token (gho_/ghu_) here
# PROMPTARO_COPILOT_CLIENT_ID= # override the OAuth app id for self-hosted setups

# Anthropic organization workspaces only: required for org-scoped keys
# ANTHROPIC_WORKSPACE_ID=

# Optional overrides
# ROUTER_HOME=/data          # where credentials.json and the quota ledger live
# ROUTER_DB=/data/router.db  # learned routing scores + cache
# ROUTER_GATEWAY_TOKEN=...   # set a fixed gateway token instead of the generated one
